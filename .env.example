# =============================================================================
# Environment Configuration for context-hub-mcp
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Configuration (Gemini)
# -----------------------------------------------------------------------------
# Required: Your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default model (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Redis Configuration (Short-term Memory)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password
# REDIS_SSL=false

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (Long-term Memory)
# -----------------------------------------------------------------------------
# Option 1: Use DATABASE_URL (takes precedence)
# DATABASE_URL=postgresql://user:password@localhost:5432/context_hub

# Option 2: Use individual components
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mcp
# POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=context_hub
POSTGRES_SSL_MODE=prefer

# -----------------------------------------------------------------------------
# Legacy LLM Configuration (for future provider swapping)
# -----------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key
# LLM_MODEL=gpt-4
# LLM_BASE_URL=
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT=60

# -----------------------------------------------------------------------------
# Feature Flags (Testing / Development)
# -----------------------------------------------------------------------------
# Force all users to be treated as PRO (bypasses plan limits for testing)
FORCE_PRO_MODE=false
